{
  "name": "promptwars-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test scripts/test.cjs",
    "format": "prettier --write src scripts tests playwright.config.ts docs .github package.json next.config.ts eslint.config.mjs tsconfig.json",
    "format:check": "prettier --check src scripts tests playwright.config.ts docs .github package.json next.config.ts eslint.config.mjs tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test:coverage": "node --experimental-test-coverage --test scripts/test.cjs",
    "test:e2e": "playwright test",
    "benchmark": "node scripts/benchmark.cjs"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "typescript": "^5"
  }
}
